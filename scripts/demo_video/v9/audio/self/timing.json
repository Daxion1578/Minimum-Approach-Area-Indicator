   "dur": 13.012,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 2.535,
     "text": "私は、変電所の工事担当"
    },
    {
     "t0": 2.935,
     "t1": 4.811,
     "text": "この遮断器を、取り替える"
    },
    {
     "t0": 5.211,
     "t1": 8.842,
     "text": "停止を申請する期限までに、決めなければならない"
    },
    {
     "t0": 9.342,
     "t1": 10.993,
     "text": "止めるのは、どこまで"
    },
    {
     "t0": 11.293,
     "t1": 13.012,
     "text": "クレーンは、何トン級"
    }
   ]
  },
  {
   "p": 2,
   "act": "C2",
   "dur": 20.148,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 2.949,
     "text": "変電所には、目に見えない充電部がある"
    },
    {
     "t0": 3.349,
     "t1": 6.454,
     "text": "ふつうの工事のように、そばにクレーンを置けない"
    },
    {
     "t0": 6.954,
     "t1": 12.501,
     "text": "近づきすぎると、触れていなくても電気が飛び移り、クレーンを伝って感電する"
    },
    {
     "t0": 13.101,
     "t1": 20.148,
     "text": "人の命にかかわり、設備が止まれば、送電線の先の需要家や発電事業者にも影響が出る"
    }
   ]
  },
  {
   "p": 3,
   "act": "C3",
   "dur": 10.202,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 1.997,
     "text": "いまは、3枚の図面から、"
    },
    {
     "t0": 2.147,
     "t1": 4.538,
     "text": "頭の中で立体を組み立てて決める"
    },
    {
     "t0": 5.138,
     "t1": 8.807,
     "text": "でも、新任の私には、まだ判断しきれない"
    },
    {
     "t0": 9.307,
     "t1": 10.202,
     "text": "不安が残る"
    }
   ]
  },
  {
   "p": 4,
   "act": "C4",
   "dur": 3.621,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 2.741,
     "text": "図面を入れれば、答えと根拠が見える"
    },
    {
     "t0": 3.141,
     "t1": 3.621,
     "text": "間合い"
    }
   ]
  },
  {
   "p": 5,
   "act": "C5",
   "dur": 12.507,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 1.637,
     "text": "まず、図面を入れる"
    },
    {
     "t0": 2.637,
     "t1": 6.488,
     "text": "構内の形と電気のつながりが、一緒に立体になる"
    },
    {
     "t0": 7.288,
     "t1": 12.507,
     "text": "二つの図面で機器がそろっているかを確かめ、読み切れない所は人に返す"
    }
   ]
  },
  {
   "p": 6,
   "act": "C6",
   "dur": 16.301,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 4.044,
     "text": "工事の依頼文を貼ると、Claudeが機器と条件を読み取る"
    },
    {
     "t0": 4.844,
     "t1": 8.479,
     "text": "送る前に、設備の名前は、符号に置き換える"
    },
    {
     "t0": 9.379,
     "t1": 13.418,
     "text": "取り替える遮断器が決まると、切る開閉器が計算で出る"
    },
    {
     "t0": 14.018,
     "t1": 16.301,
     "text": "送電線は、相手端も切る"
    }
   ]
  },
  {
   "p": 7,
   "act": "C7",
   "dur": 25.388,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 3.144,
     "text": "平面図で資材の置き場を決め、重さを入れる"
    },
    {
     "t0": 3.944,
     "t1": 6.193,
     "text": "10トンを吊るのに、100トン級"
    },
    {
     "t0": 6.893,
     "t1": 11.161,
     "text": "重さだけなら25トン級でも、母線から離れるには足りない"
    },
    {
     "t0": 12.061,
     "t1": 14.442,
     "text": "据えてよい所は、緑のマス"
    },
    {
     "t0": 14.942,
     "t1": 18.314,
     "text": "動かすと、その場所で使える級に選び直す"
    },
    {
     "t0": 19.314,
     "t1": 23.36,
     "text": "母線は止められないと依頼文にあるので、止める案は出さない"
    },
    {
     "t0": 23.96,
     "t1": 25.388,
     "text": "決めるのは、人"
    }
   ]
  },
  {
   "p": 8,
   "act": "C8",
   "dur": 10.191,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 2.64,
     "text": "この配置でOKを押すと、承認"
    },
    {
     "t0": 3.64,
     "t1": 7.003,
     "text": "停止範囲の結線図と、クレーンの配置図が出る"
    },
    {
     "t0": 7.803,
     "t1": 10.191,
     "text": "これで、期限までに申請できる"
    }
   ]
  },
  {
   "p": 9,
   "act": "C9",
   "dur": 17.334,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 2.404,
     "text": "判定は計算、承認は人"
    },
    {
     "t0": 2.904,
     "t1": 4.868,
     "text": "開発は、Claude Code"
    },
    {
     "t0": 5.168,
     "t1": 7.713,
     "text": "ソフトの開発は、経験が浅い"
    },
    {
     "t0": 8.013,
     "t1": 10.374,
     "text": "コマンドは、一つも覚えていない"
    },
    {
     "t0": 10.674,
     "t1": 13.801,
     "text": "点検と残りの整理は、係に任せた"
    },
    {
     "t0": 14.101,
     "t1": 17.334,
     "text": "決めたことを記録に残し、毎回読ませた"
    }
   ]
  },
  {
   "p": 10,
   "act": "C10",
   "dur": 7.427,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 2.186,
     "text": "現場は、命を預かっている"
    },
    {
     "t0": 2.586,
     "t1": 4.578,
     "text": "だから、最後は人が決める"
    },
    {
     "t0": 5.278,
     "t1": 7.427,
     "text": "見えない間合いを、見えるように"
    }
   ]
