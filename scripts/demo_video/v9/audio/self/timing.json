{
 "variant": "self",
 "credit": "VOICEVOX:冥鳴ひまり",
 "paragraphs": [
  {
   "p": 1,
   "act": "C1",
   "dur": 15.578,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 2.365,
     "text": "私は、変電所の工事担当"
    },
    {
     "t0": 2.765,
     "t1": 4.514,
     "text": "この遮断器を、取り替える"
    },
    {
     "t0": 5.014,
     "t1": 6.025,
     "text": "重さは10トン"
    },
    {
     "t0": 6.325,
     "t1": 8.32,
     "text": "なのに、クレーンは100トン級"
    },
    {
     "t0": 8.82,
     "t1": 11.905,
     "text": "決め手は、重さではなく、電気との間合い"
    },
    {
     "t0": 12.405,
     "t1": 15.578,
     "text": "止める範囲とクレーンを、申請の期限までに決める"
    }
   ]
  },
  {
   "p": 2,
   "act": "C2",
   "dur": 17.649,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 3.496,
     "text": "変電所では、近づいてよい距離が、目に見えない"
    },
    {
     "t0": 3.996,
     "t1": 9.526,
     "text": "近づきすぎると、触れていなくても電気が飛び移り、クレーンを伝って人が感電する"
    },
    {
     "t0": 10.026,
     "t1": 13.241,
     "text": "感電の重大事故は、4年間で35件"
    },
    {
     "t0": 13.741,
     "t1": 17.649,
     "text": "設備が止まれば、需要家や発電事業者にも影響が出る"
    }
   ]
  },
  {
   "p": 3,
   "act": "C3",
   "dur": 13.429,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 2.847,
     "text": "いまは、ベテランが、3枚の図面から、"
    },
    {
     "t0": 2.997,
     "t1": 5.224,
     "text": "頭の中で立体を組み立てて決める"
    },
    {
     "t0": 5.724,
     "t1": 10.149,
     "text": "ある会社では、変電の作業員の約半分が、50代以上"
    },
    {
     "t0": 10.649,
     "t1": 13.429,
     "text": "新任の私には、まだ判断しきれない"
    }
   ]
  },
  {
   "p": 4,
   "act": "C4",
   "dur": 9.572,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 2.537,
     "text": "図面を入れれば、答えと根拠が見える"
    },
    {
     "t0": 2.937,
     "t1": 3.376,
     "text": "間合い"
    },
    {
     "t0": 4.176,
     "t1": 7.752,
     "text": "読むのはClaude、判定は計算、決めるのは人"
    },
    {
     "t0": 8.152,
     "t1": 9.572,
     "text": "あえて、そう分けた"
    }
   ]
  },
  {
   "p": 5,
   "act": "C5",
   "dur": 13.754,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 4.196,
     "text": "変電所の形と電気のつながりを、図面から一つの立体にする"
    },
    {
     "t0": 4.896,
     "t1": 10.062,
     "text": "記号の意味はClaudeが読み、人に確かめることは、15件から5件に減る"
    },
    {
     "t0": 10.662,
     "t1": 13.754,
     "text": "二つの図面で、機器がそろっているかも確かめる"
    }
   ]
  },
  {
   "p": 6,
   "act": "C6",
   "dur": 17.11,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 3.796,
     "text": "工事の依頼文を貼ると、Claudeが機器と条件を読み取る"
    },
    {
     "t0": 4.396,
     "t1": 7.739,
     "text": "本当の名前は、仮の名前に置き換えてから送る"
    },
    {
     "t0": 8.339,
     "t1": 10.814,
     "text": "人が原文と並べて確かめ、入れる"
    },
    {
     "t0": 11.414,
     "t1": 13.526,
     "text": "切る開閉器は、計算で出る"
    },
    {
     "t0": 14.026,
     "t1": 17.11,
     "text": "送電線は、向こうの変電所でも止めてもらう"
    }
   ]
  },
  {
   "p": 7,
   "act": "C7",
   "dur": 23.543,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 2.962,
     "text": "平面図で資材の置き場を決め、重さを入れる"
    },
    {
     "t0": 3.662,
     "t1": 6.199,
     "text": "重さだけなら、25トン級で足りる"
    },
    {
     "t0": 6.599,
     "t1": 9.783,
     "text": "でも、どこに据えても、母線に近づきすぎる"
    },
    {
     "t0": 10.483,
     "t1": 13.28,
     "text": "母線を止められれば、25トン級で済む"
    },
    {
     "t0": 13.68,
     "t1": 16.956,
     "text": "でも依頼文には、母線は止められない、とある"
    },
    {
     "t0": 17.256,
     "t1": 20.068,
     "text": "Claudeが読み、人が確かめた条件だ"
    },
    {
     "t0": 20.768,
     "t1": 23.543,
     "text": "だから、10トンを吊るのに、100トン級"
    }
   ]
  },
  {
   "p": 8,
   "act": "C8",
   "dur": 13.898,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 2.937,
     "text": "この配置でOKを押すと、計画が決まる"
    },
    {
     "t0": 3.737,
     "t1": 7.268,
     "text": "停止範囲の結線図と、クレーン配置の平面図が出る"
    },
    {
     "t0": 7.768,
     "t1": 10.957,
     "text": "検電と接地、相手端の条件も書いてある"
    },
    {
     "t0": 11.457,
     "t1": 13.898,
     "text": "これを添えて、期限までに申請する"
    }
   ]
  },
  {
   "p": 9,
   "act": "C9",
   "dur": 18.089,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 2.936,
     "text": "開発は、Claude Codeで、1週間"
    },
    {
     "t0": 3.336,
     "t1": 8.347,
     "text": "私は、ソフトの開発の経験が浅く、コマンドは一つも覚えていない"
    },
    {
     "t0": 8.747,
     "t1": 13.879,
     "text": "手順はSkill、点検はサブエージェント、公開前の安全はフックに任せた"
    },
    {
     "t0": 14.279,
     "t1": 18.089,
     "text": "前提を知らない係の点検で、見つかった穴も直した"
    }
   ]
  },
  {
   "p": 10,
   "act": "C10",
   "dur": 12.753,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 2.599,
     "text": "変圧器だけで、約1万5千台"
    },
    {
     "t0": 2.899,
     "t1": 6.029,
     "text": "全部を替えるには、いまのペースで約70年"
    },
    {
     "t0": 6.529,
     "t1": 10.059,
     "text": "そのたびに、次の担当者が、この二つを決める"
    },
    {
     "t0": 10.759,
     "t1": 12.753,
     "text": "見えない間合いを、見えるように"
    }
   ]
  }
 ]
}