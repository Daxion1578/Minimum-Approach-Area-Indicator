 "paragraphs": [
  {
   "p": 1,
   "act": "C1",
   "dur": 15.944,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 2.334,
     "text": "私は、変電所の工事担当"
    },
    {
     "t0": 2.734,
     "t1": 4.673,
     "text": "この遮断器を、取り替える"
    },
    {
     "t0": 5.173,
     "t1": 6.226,
     "text": "重さは10トン"
    },
    {
     "t0": 6.526,
     "t1": 8.646,
     "text": "なのに、クレーンは100トン級"
    },
    {
     "t0": 9.146,
     "t1": 12.147,
     "text": "決め手は、重さではなく、電気との間合い"
    },
    {
     "t0": 12.647,
     "t1": 15.944,
     "text": "止める範囲とクレーンを、申請の期限までに決める"
    }
   ]
  },
  {
   "p": 2,
   "act": "C2",
   "dur": 17.472,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 3.281,
     "text": "変電所では、近づいてよい距離が、目に見えない"
    },
    {
     "t0": 3.781,
     "t1": 9.394,
     "text": "近づきすぎると、触れていなくても電気が飛び移り、クレーンを伝って人が感電する"
    },
    {
     "t0": 9.894,
     "t1": 13.054,
     "text": "感電の重大事故は、4年間で35件"
    },
    {
     "t0": 13.554,
     "t1": 17.472,
     "text": "設備が止まれば、需要家や発電事業者にも影響が出る"
    }
   ]
  },
  {
   "p": 3,
   "act": "C3",
   "dur": 11.265,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 2.874,
     "text": "いまは、ベテランが、3枚の図面から、"
    },
    {
     "t0": 3.024,
     "t1": 5.228,
     "text": "頭の中で立体を組み立てて決める"
    },
    {
     "t0": 5.728,
     "t1": 8.113,
     "text": "その経験は、図面には残らない"
    },
    {
     "t0": 8.613,
     "t1": 11.265,
     "text": "新任の私には、まだ判断しきれない"
    }
   ]
  },
  {
   "p": 4,
   "act": "C4",
   "dur": 9.565,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 2.593,
     "text": "図面を入れれば、答えと根拠が見える"
    },
    {
     "t0": 2.993,
     "t1": 3.437,
     "text": "間合い"
    },
    {
     "t0": 4.237,
     "t1": 7.77,
     "text": "読むのはClaude、判定は計算、決めるのは人"
    },
    {
     "t0": 8.17,
     "t1": 9.565,
     "text": "あえて、そう分けた"
    }
   ]
  },
  {
   "p": 5,
   "act": "C5",
   "dur": 13.563,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 4.283,
     "text": "変電所の形と電気のつながりを、図面から一つの立体にする"
    },
    {
     "t0": 4.983,
     "t1": 9.763,
     "text": "記号の意味はClaudeが読み、人に確かめることは、15件から5件に減る"
    },
    {
     "t0": 10.363,
     "t1": 13.563,
     "text": "二つの図面で、機器がそろっているかも確かめる"
    }
   ]
  },
  {
   "p": 6,
   "act": "C6",
   "dur": 21.462,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 3.97,
     "text": "工事の条件を文で書くと、Claudeが機器と条件を読み取る"
    },
    {
     "t0": 4.37,
     "t1": 11.036,
     "text": "AIに渡す情報は最小限にするため、名前を仮の名前にして送り、戻ってから元に戻す"
    },
    {
     "t0": 11.436,
     "t1": 14.139,
     "text": "人が原文と並べて確かめ、入れる"
    },
    {
     "t0": 14.539,
     "t1": 17.966,
     "text": "取り替える機器が決まれば、切る開閉器は計算で出る"
    },
    {
     "t0": 18.366,
     "t1": 21.462,
     "text": "送電線は、向こうの変電所でも止めてもらう"
    }
   ]
  },
  {
   "p": 7,
   "act": "C7",
   "dur": 25.231,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 3.026,
     "text": "平面図で資材の置き場を決め、重さを入れる"
    },
    {
     "t0": 3.526,
     "t1": 7.086,
     "text": "荷重表の重さと距離だけなら、25トン級で足りる"
    },
    {
     "t0": 7.486,
     "t1": 12.223,
     "text": "でも、70トン級までは、どこに据えても、母線に近づきすぎる"
    },
    {
     "t0": 12.723,
     "t1": 15.569,
     "text": "母線を止められれば、25トン級で済む"
    },
    {
     "t0": 15.969,
     "t1": 18.944,
     "text": "でも、母線は系統の都合で止められない"
    },
    {
     "t0": 19.244,
     "t1": 21.79,
     "text": "Claudeが読み、人が確かめた条件だ"
    },
    {
     "t0": 22.29,
     "t1": 25.231,
     "text": "だから、10トンを吊るのに、100トン級"
    }
   ]
  },
  {
   "p": 8,
   "act": "C8",
   "dur": 13.986,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 2.814,
     "text": "この配置でOKを押すと、計画が決まる"
    },
    {
     "t0": 3.614,
     "t1": 7.228,
     "text": "停止範囲の結線図と、クレーン配置の平面図が出る"
    },
    {
     "t0": 7.728,
     "t1": 11.026,
     "text": "検電と接地、相手端の条件も書いてある"
    },
    {
     "t0": 11.526,
     "t1": 13.986,
     "text": "これを添えて、期限までに申請する"
    }
   ]
  },
  {
   "p": 9,
   "act": "C9",
   "dur": 17.983,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 2.984,
     "text": "開発は、Claude Codeで、1週間"
    },
    {
     "t0": 3.384,
     "t1": 8.309,
     "text": "私は、ソフトの開発の経験が浅く、コマンドは一つも覚えていない"
    },
    {
     "t0": 8.709,
     "t1": 13.808,
     "text": "手順はSkill、点検はサブエージェント、公開前の安全はフックに任せた"
    },
    {
     "t0": 14.208,
     "t1": 17.983,
     "text": "前提を知らない係の点検で、見つかった穴も直した"
    }
   ]
  },
  {
   "p": 10,
   "act": "C10",
   "dur": 12.695,
   "src": "voicevox",
   "cues": [
    {
     "t0": 0.0,
     "t1": 2.602,
     "text": "変圧器だけで、約1万5千台"
    },
    {
     "t0": 2.902,
     "t1": 5.898,
     "text": "全部を替えるには、いまのペースで約70年"
    },
    {
     "t0": 6.398,
     "t1": 9.91,
     "text": "そのたびに、次の担当者が、この二つを決める"
    },
    {
     "t0": 10.61,
     "t1": 12.695,
     "text": "見えない間合いを、見えるように"
    }
   ]
  }
 ]
