{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maai.example/contracts/layout.schema.json",
  "title": "layout.json — 配置（構内ローカル座標、m）",
  "description": "docs/spec.md §6.2。X=東, Y=北, Z=上。導体・充電部はすべてカプセル（線分＋半径）。`items[].id` は topology のノードID または 辺ID で、そのノード／辺の電気的状態がカプセルの状態になる。`structures` は電気的につながらない構造物（架空地線・鉄構など）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "site_id", "items"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "site_id": { "type": "string", "pattern": "^SITE-[0-9]{2}$" },
    "generated_by": { "type": "string" },
    "origin_note": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "reference_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "x", "y"],
        "properties": {
          "id": { "type": "string" },
          "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" },
          "note": { "type": "string" }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "primitives"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "at": { "$ref": "#/$defs/point", "description": "機器の代表位置（記号を置く点）。カプセルを持たない機器にも付ける" },
          "primitives": { "type": "array", "items": { "$ref": "#/$defs/capsule" } }
        }
      }
    },
    "structures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "primitives"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["ground_wire", "gantry", "fence", "other"] },
          "name": { "type": "string" },
          "primitives": { "type": "array", "items": { "$ref": "#/$defs/capsule" } }
        }
      }
    }
  },
  "$defs": {
    "point": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "capsule": {
      "type": "object",
      "required": ["type", "a", "b", "r"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "capsule" },
        "a": { "$ref": "#/$defs/point" },
        "b": { "$ref": "#/$defs/point" },
        "r": { "type": "number", "minimum": 0 },
        "phase": { "type": "string", "enum": ["R", "S", "T", "N"] }
      }
    }
  }
}
