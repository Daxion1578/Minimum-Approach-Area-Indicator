# 秘密情報・ローカル専用
.env
*.local.*
!*.local.example.*

# 送信記録・提案ログ（実データが混ざりうる）
logs/

# 持ち込まない形式（実図面・社内資料）
*.dwg
*.xdw
*.xbd

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# OS / エディタ
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code の個人設定
.claude/settings.local.json

data/sites/*/approved/
_site/

# 動画の素材（engine の出力の写しと、描いた映像。作り直せる）
scripts/ar_concept/concept.json
*.mp4

# 動画 v8 の書き出し・途中のファイル（scripts/demo_video/v8/README.md）
scripts/demo_video/v8/out/
scripts/demo_video/v8/vv/
scripts/demo_video/v8/audio/*/jobs.json
scripts/demo_video/v8/audio/*/*.wav
scripts/demo_video/v8/audio/*/seg/*.wav
# 操作の録画は 51MB で公開前チェックの上限（5MB）を超えるので入れない（受け取り方は v8/README.md）
scripts/demo_video/v8/assets/rec/*.webm

# 動画 v9 の書き出し・途中のファイル・録画・本人の声（scripts/demo_video/v9/README.md）
scripts/demo_video/v9/out/
scripts/demo_video/v9/vv/
